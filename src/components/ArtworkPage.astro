---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import type { Artwork } from '../lib/data';
import { img } from '../lib/images';
import { pick, ui, type Lang } from '../lib/i18n';
import { langUrl } from '../lib/url';

interface Props {
  lang: Lang;
  work: Artwork;
}
const { lang, work } = Astro.props;
const t = ui[lang];
const d = work.data;
const title = pick(lang, d.title_zh, d.title_en);
const medium = pick(lang, d.medium_zh, d.medium_en);
const description = pick(lang, d.description_zh, d.description_en);

const images = await Promise.all(
  d.images.map(async (path, i) => {
    const meta = img(path);
    const full = await getImage({ src: meta, width: Math.min(meta.width, 2200), format: 'webp' });
    return { meta, full: full.src, alt: i === 0 ? title : `${title} (${i + 1})` };
  }),
);
const [main, ...details] = images;
---

<Base lang={lang} title={title} path={`/works/${work.id}/`} current="works">
  <a class="back" href={langUrl(lang, '/')}>{t.back}</a>

  <article class="work">
    <div class="media">
      <button class="zoom main" type="button" data-index="0" aria-label={`${t.enlarge}: ${main.alt}`}>
        <Image src={main.meta} alt={main.alt} widths={[800, 1400]} sizes="(max-width: 900px) 100vw, 62vw" />
      </button>
      {
        details.length > 0 && (
          <div class="thumbs">
            {details.map((im, i) => (
              <button class="zoom" type="button" data-index={i + 1} aria-label={`${t.enlarge}: ${im.alt}`}>
                <Image src={im.meta} alt={im.alt} widths={[400, 800]} sizes="(max-width: 900px) 50vw, 30vw" />
              </button>
            ))}
          </div>
        )
      }
    </div>

    <div class="info">
      <h1>{title}</h1>
      <dl>
        <dt class="sr-only">{t.year}</dt>
        <dd>{d.year}</dd>
        {
          medium && (
            <>
              <dt class="sr-only">{t.medium}</dt>
              <dd>{medium}</dd>
            </>
          )
        }
        {
          d.size && (
            <>
              <dt class="sr-only">{t.size}</dt>
              <dd>{d.size}</dd>
            </>
          )
        }
      </dl>
      {description && <p class="desc">{description}</p>}
    </div>
  </article>

  <dialog class="lightbox" aria-label={title}>
    <img src="" alt="" />
    <button class="lb-close" type="button" aria-label={t.close}>✕</button>
    {
      images.length > 1 && (
        <>
          <button class="lb-prev" type="button" aria-label={t.prev}>‹</button>
          <button class="lb-next" type="button" aria-label={t.next}>›</button>
          <span class="lb-count"></span>
        </>
      )
    }
  </dialog>

  <script is:inline type="application/json" id="lightbox-data" set:html={JSON.stringify(images.map((im) => ({ src: im.full, alt: im.alt })))}></script>
</Base>

<script>
  type Item = { src: string; alt: string };
  const items: Item[] = JSON.parse(document.getElementById('lightbox-data')?.textContent || '[]');
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const picture = dialog?.querySelector('img');
  const count = dialog?.querySelector('.lb-count');
  let index = 0;

  function show(i: number) {
    if (!dialog || !picture || !items.length) return;
    index = (i + items.length) % items.length;
    picture.src = items[index].src;
    picture.alt = items[index].alt;
    if (count) count.textContent = `${index + 1} / ${items.length}`;
    if (!dialog.open) dialog.showModal();
  }

  document.querySelectorAll<HTMLButtonElement>('.zoom').forEach((b) =>
    b.addEventListener('click', () => show(Number(b.dataset.index) || 0)),
  );
  dialog?.querySelector('.lb-close')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('.lb-prev')?.addEventListener('click', () => show(index - 1));
  dialog?.querySelector('.lb-next')?.addEventListener('click', () => show(index + 1));

  // 點背景關閉
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });

  // 手機左右滑動
  let startX = 0;
  dialog?.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
  dialog?.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50 && items.length > 1) show(dx < 0 ? index + 1 : index - 1);
  });
</script>

<style>
  .back {
    display: inline-block;
    margin: 8px 0 28px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .back:hover {
    color: var(--fg);
  }
  .work {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .work {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
  .zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--surface);
    cursor: zoom-in;
  }
  .zoom :global(img) {
    width: 100%;
  }
  .thumbs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
  }
  .info {
    position: sticky;
    top: 32px;
  }
  .info h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    margin: 0 0 12px;
  }
  .info dl {
    margin: 0 0 24px;
    color: var(--muted);
  }
  .info dd {
    margin: 0;
  }
  .desc {
    margin: 0;
    white-space: pre-line;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--overlay);
    color: #fff;
  }
  .lightbox::backdrop {
    background: var(--overlay);
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox img {
    max-width: calc(100vw - 32px);
    max-height: calc(100dvh - 96px);
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lightbox button {
    position: absolute;
    background: none;
    border: 0;
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    padding: 12px 16px;
    cursor: pointer;
    opacity: 0.8;
  }
  .lightbox button:hover {
    opacity: 1;
  }
  .lb-close {
    top: 8px;
    right: 8px;
    font-size: 1.4rem !important;
  }
  .lb-prev {
    left: 4px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 3rem !important;
  }
  .lb-next {
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 3rem !important;
  }
  .lb-count {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.85rem;
    opacity: 0.7;
  }
</style>
